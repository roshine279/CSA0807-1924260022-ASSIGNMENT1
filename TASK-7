"""Rate card of the village milk co-operative."""

from decimal import Decimal, ROUND_HALF_UP

BASE_RATE = Decimal("30.00")
FAT_STEP_VALUE = Decimal("0.40")
SNF_STEP_VALUE = Decimal("0.30")
STEP_SIZE = Decimal("0.1")
STANDARD_FAT = Decimal("3.5")
STANDARD_SNF = Decimal("8.5")
CENT = Decimal("0.01")


def rate_per_litre(fat, snf):
    """Return the price per litre, rounded to two decimals."""
    fat_steps = int(
        ((fat - STANDARD_FAT) / STEP_SIZE).to_integral_value(
            rounding=ROUND_HALF_UP
        )
    )
    snf_steps = int(
        ((snf - STANDARD_SNF) / STEP_SIZE).to_integral_value(
            rounding=ROUND_HALF_UP
        )
    )

    rate = (
        BASE_RATE
        + fat_steps * FAT_STEP_VALUE
        + snf_steps * SNF_STEP_VALUE
    )
    return rate.quantize(CENT, rounding=ROUND_HALF_UP)


def payout(litres, fat, snf):
    """Return the payment rounded to two decimals."""
    amount = litres * rate_per_litre(fat, snf)
    return amount.quantize(CENT, rounding=ROUND_HALF_UP)


if __name__ == "__main__":
    for litres, fat, snf in [
        ("10", "3.5", "8.5"),
        ("8.5", "4.2", "8.7"),
        ("12", "3.1", "8.3"),
    ]:
        litres = Decimal(litres)
        fat = Decimal(fat)
        snf = Decimal(snf)

        rate = rate_per_litre(fat, snf)
        pay = payout(litres, fat, snf)

        print(
            f"{litres:5} L  fat {fat}  snf {snf}"
            f"  rate {rate:6.2f}  pay {pay:8.2f}"
